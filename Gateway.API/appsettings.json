{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "CorsPolicy": "CorsPolicy",
        "Order": 1,
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "CorsPolicy": "CorsPolicy",
        "Order": 2,
        "Match": {
          "Path": "/api/basket/{**catch-all}"
        }
      },
      "ordering-route": {
        "ClusterId": "ordering-cluster",
        "CorsPolicy": "CorsPolicy",
        "Order": 3,
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "CorsPolicy": "CorsPolicy",
        "Order": 4,
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "identity-account-route": {
        "ClusterId": "identity-cluster",
        "CorsPolicy": "CorsPolicy",
        "Order": 5,
        "Match": {
          "Path": "/api/account/{**catch-all}"
        }
      },
      "identity-login-route": {
        "ClusterId": "identity-cluster",
        "CorsPolicy": "CorsPolicy",
        "Order": 6,
        "Match": {
          "Path": "/api/login"
        }
      },
      "identity-register-route": {
        "ClusterId": "identity-cluster",
        "CorsPolicy": "CorsPolicy",
        "Order": 7,
        "Match": {
          "Path": "/api/register"
        }
      },
      "identity-refresh-route": {
        "ClusterId": "identity-cluster",
        "CorsPolicy": "CorsPolicy",
        "Order": 8,
        "Match": {
          "Path": "/api/refresh"
        }
      },
      "identity-manage-route": {
        "ClusterId": "identity-cluster",
        "CorsPolicy": "CorsPolicy",
        "Order": 9,
        "Match": {
          "Path": "/api/manage/{**catch-all}"
        }
      },
      "api-fallback-route": {
        "ClusterId": "monolith-cluster",
        "CorsPolicy": "CorsPolicy",
        "Order": 10,
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5001"
          }
        }
      },
      "basket-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5003"
          }
        }
      },
      "ordering-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5268"
          }
        }
      },
      "payments-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5025"
          }
        }
      },
      "identity-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5051"
          }
        }
      },
      "monolith-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5868"
          }
        }
      }
    }
  }
}